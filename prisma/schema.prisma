// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  ADMIN
  SUPERVISOR
  OPERADOR
  CLIENTE // cuenta de portal, ligada a un Cliente
}

enum EstadoPesaje {
  TARA_CAPTURADA
  CARGA_REGISTRADA // artículo, pacas, destino y firma de salida ya capturados — falta pasar por báscula
  COMPLETO
  ANULADO
}

enum EstadoCompra {
  ABIERTA
  CERRADA
  CANCELADA
}

enum EstadoVenta {
  BORRADOR
  PENDIENTE_APROBACION // tolerancia excedida, bloqueada
  CERRADA
  CANCELADA
}

enum TipoFirma {
  SALIDA_PROVEEDOR // transportista, al salir del proveedor
  VALIDACION_SUPERVISOR // "Supervisor MP" validando físicamente
  RECEPCION_CLIENTE
  EXCEPCION_TOLERANCIA // supervisor autoriza exceder tolerancia
}

enum TipoEvidencia {
  TICKET_TARA // foto del ticket al pesar el camión vacío
  TICKET_BASCULA // foto del ticket al cerrar (peso cargado)
  COMPROBANTE_CLIENTE
  OTRO
}

model Ubicacion {
  id                 Int      @id @default(autoincrement())
  nombre             String
  codigo             String   @unique
  netsuiteLocationId String? // ID interno del Location en NetSuite, para Órdenes de Compra/Venta
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())

  usuarios Usuario[]
  pesajes  Pesaje[]
  compras  Compra[]
  ventas   Venta[]
  lotes    Lote[]

  notificaciones     Notificacion[]
  reglasNotificacion ReglaNotificacion[]
}

model Usuario {
  id                 Int         @id @default(autoincrement())
  nombre             String
  email              String      @unique
  passwordHash       String
  role               RoleUsuario
  activo             Boolean     @default(true)
  ubicacionId        Int? // sede base; null = cruza ubicaciones (admin/supervisor)
  ubicacion          Ubicacion?  @relation(fields: [ubicacionId], references: [id])
  clienteId          Int? // solo para role = CLIENTE (cuenta de portal)
  cliente            Cliente?    @relation(fields: [clienteId], references: [id])
  netsuiteEmployeeId String? // ID interno del Employee en NetSuite — usuario que envía la orden
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  pesajesCreados             Pesaje[]             @relation("PesajeCreadoPor")
  ventasCreadas              Venta[]              @relation("VentaCreadaPor")
  ventasReportadasPorCliente Venta[]              @relation("VentaReportadaPorCliente")
  evidencias                 Evidencia[]
  firmas                     Firma[]
  auditLogs                  AuditLog[]
  resetTokens                PasswordResetToken[]
  notificaciones             NotificacionDestinatario[]
  reglasNotificacion         ReglaNotificacion[]
}

// Departamento de NetSuite ("department") usado como "Centro de Aprobación"
// en el formulario de Purchase/Sales Order de esta cuenta. Varias filas
// posibles, pero solo una marcada "predeterminado" se usa al enviar.
model CentroAprobacion {
  id             Int      @id @default(autoincrement())
  nombre         String
  netsuiteId     String
  predeterminado Boolean  @default(false)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Proveedor {
  id               Int      @id @default(autoincrement())
  nombre           String
  rfc              String?
  telefono         String?
  netsuiteVendorId String? // ID interno del Vendor en NetSuite, para la Orden de Compra
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  pesajes Pesaje[]
  compras Compra[]
}

model Cliente {
  id                 Int      @id @default(autoincrement())
  nombre             String
  rfc                String?
  telefono           String?
  netsuiteCustomerId String? // ID interno del Customer en NetSuite, para la Orden de Venta
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())

  usuarios Usuario[]
  ventas   Venta[]
}

model Articulo {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique // ej. "Cartón"
  netsuiteItemId String? // ID interno del Item en NetSuite (inventariable, no lotificado)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  pesajes     Pesaje[]
  lotes       Lote[]
  ventas      Venta[]
  tolerancias ToleranciaConfig[]
}

model UnidadEmpaque {
  id     Int     @id @default(autoincrement())
  nombre String  @unique // "Paca Grande", "Paca Chica"
  activo Boolean @default(true)

  pesajeConteos PesajeEmpaque[]
}

model Transportista {
  // catálogo ligero de autocompletado, no gestiona flete/contratos
  id        Int      @id @default(autoincrement())
  nombre    String
  placas    String
  createdAt DateTime @default(now())

  pesajes Pesaje[]
  ventas  Venta[]

  @@unique([nombre, placas])
}

model ToleranciaConfig {
  id               Int       @id @default(autoincrement())
  articuloId       Int? // null = default global
  articulo         Articulo? @relation(fields: [articuloId], references: [id])
  porcentajeUmbral Decimal   @db.Decimal(5, 2) // ej. 3.00 = 3%
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([articuloId])
}

model Lote {
  id             Int       @id @default(autoincrement())
  folio          String    @unique // L-YYYYMMDD-###
  folioCorregido Boolean   @default(false)
  ubicacionId    Int
  ubicacion      Ubicacion @relation(fields: [ubicacionId], references: [id])
  articuloId     Int
  articulo       Articulo  @relation(fields: [articuloId], references: [id])
  fecha          DateTime  @default(now())
  estado         String    @default("ABIERTO") // ABIERTO | CERRADO
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  compras     Compra[]
  movimientos LoteMovimiento[]
  pesajes     Pesaje[]
}

model Pesaje {
  id                 Int       @id @default(autoincrement())
  folioTicket        String // folio físico de báscula — referencia, no identidad
  idOperacionBascula String? // ID/folio de operación impreso en el ticket, distinto del folioTicket
  ubicacionId        Int
  ubicacion          Ubicacion @relation(fields: [ubicacionId], references: [id])
  articuloId         Int? // se define al registrar la salida (carga) — en la tara el camión va vacío
  articulo           Articulo? @relation(fields: [articuloId], references: [id])
  proveedorId        Int
  proveedor          Proveedor @relation(fields: [proveedorId], references: [id])
  loteId             Int? // se crea al cerrar (báscula) — el lote nace con el pesaje, no con la compra
  lote               Lote?     @relation(fields: [loteId], references: [id])

  transportistaId Int?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])
  operadorNombre  String
  placas          String
  pesadorNombre   String? // empleado de báscula, confirmado al cerrar

  taraKg          Decimal   @db.Decimal(10, 2)
  taraCapturadaEn DateTime
  grossKg         Decimal?  @db.Decimal(10, 2)
  netoKg          Decimal?  @db.Decimal(10, 2)
  netoCapturadoEn DateTime?

  clienteDestinoReferencia String? // nombre anotado a mano al registrar la salida, informativo
  observaciones            String?
  motivoAnulacion          String?
  estado                   EstadoPesaje @default(TARA_CAPTURADA)

  createdByUsuarioId Int
  createdBy          Usuario  @relation("PesajeCreadoPor", fields: [createdByUsuarioId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empaqueConteos PesajeEmpaque[]
  evidencias     Evidencia[]
  firmas         Firma[]
  compra         Compra?
}

model PesajeEmpaque {
  pesajeId        Int
  pesaje          Pesaje        @relation(fields: [pesajeId], references: [id])
  unidadEmpaqueId Int
  unidadEmpaque   UnidadEmpaque @relation(fields: [unidadEmpaqueId], references: [id])
  cantidad        Int

  @@id([pesajeId, unidadEmpaqueId])
}

model Compra {
  id               Int          @id @default(autoincrement())
  pesajeId         Int          @unique
  pesaje           Pesaje       @relation(fields: [pesajeId], references: [id])
  ubicacionId      Int
  ubicacion        Ubicacion    @relation(fields: [ubicacionId], references: [id])
  proveedorId      Int
  proveedor        Proveedor    @relation(fields: [proveedorId], references: [id])
  loteId           Int?
  lote             Lote?        @relation(fields: [loteId], references: [id])
  precioUnitarioKg Decimal      @db.Decimal(10, 2)
  importeTotal     Decimal      @db.Decimal(12, 2)
  estado           EstadoCompra @default(ABIERTA)
  // Fecha real de la operación (= pesaje.netoCapturadoEn al crear la
  // compra) — createdAt es cuándo se registró en la app, que puede ser
  // días después si el ticket físico tarda en llegar. Corregible por
  // un ADMIN (ver corregirCompra) si hace falta ajustarla después.
  fechaOperacion   DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  netsuiteOrderId     String? // ID interno de la Purchase Order en NetSuite
  netsuiteOrderNumber String? // tranId (folio legible), ej. "PO123"
  netsuiteSyncedAt    DateTime?
}

model Venta {
  id          Int       @id @default(autoincrement())
  ubicacionId Int
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  clienteId   Int
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  articuloId  Int
  articulo    Articulo  @relation(fields: [articuloId], references: [id])

  transportistaId Int?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])
  operadorNombre  String?
  placas          String?

  pesoVendidoKg          Decimal  @db.Decimal(10, 2) // suma de LoteMovimiento asignados
  pesoReportadoClienteKg Decimal? @db.Decimal(10, 2) // crudo, nunca se sobreescribe
  // pesoVendidoKg - pesoReportadoClienteKg: positivo = merma (cliente reportó
  // menos), negativo = sobrante (reportó más). Se calcula solo, nunca se
  // captura a mano — ver reportarPesoVenta.
  diferenciaKg     Decimal @default(0) @db.Decimal(10, 2)
  motivoDiferencia String? // obligatorio en la app si diferenciaKg != 0

  // Fecha real en que se registra la venta (puede ser días después de que
  // se asignó el lote, si la captura se atrasa) — mismo criterio que
  // Compra.fechaOperacion. Se captura al crear la venta, editable después
  // vía corregirVenta.
  fechaOperacion DateTime

  // Fecha real en que se reportó el peso (ver reportarPesoVenta) — null
  // mientras sigue en Borrador. Una vez seteada, es la fecha más precisa de
  // la operación (mejor que fechaOperacion) para reportes/exports/NetSuite.
  // Corregible por un ADMIN (ver corregirVenta) si hace falta ajustarla
  // después.
  pesoReportadoEn DateTime?

  precioUnitarioKg   Decimal     @db.Decimal(10, 2)
  importeTotal       Decimal     @db.Decimal(12, 2)
  estado             EstadoVenta @default(BORRADOR)
  toleranciaExcedida Boolean     @default(false)

  netsuiteOrderId     String? // ID interno de la Sales Order en NetSuite
  netsuiteOrderNumber String? // tranId (folio legible), ej. "SO456"
  netsuiteSyncedAt    DateTime?

  createdByUsuarioId           Int
  createdBy                    Usuario  @relation("VentaCreadaPor", fields: [createdByUsuarioId], references: [id])
  reportadoPorClienteUsuarioId Int?
  reportadoPorCliente          Usuario? @relation("VentaReportadaPorCliente", fields: [reportadoPorClienteUsuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimientos LoteMovimiento[]
  evidencias  Evidencia[]
  firmas      Firma[]
}

model LoteMovimiento {
  id                 Int      @id @default(autoincrement())
  loteId             Int
  lote               Lote     @relation(fields: [loteId], references: [id])
  ventaId            Int
  venta              Venta    @relation(fields: [ventaId], references: [id])
  pesoAsignadoKg     Decimal  @db.Decimal(10, 2)
  createdByUsuarioId Int
  createdAt          DateTime @default(now())

  @@index([loteId])
  @@index([ventaId])
}

model Firma {
  id                    Int       @id @default(autoincrement())
  tipo                  TipoFirma
  pesajeId              Int?
  pesaje                Pesaje?   @relation(fields: [pesajeId], references: [id])
  ventaId               Int?
  venta                 Venta?    @relation(fields: [ventaId], references: [id])
  nombreFirmante        String
  horaFirma             DateTime  @default(now())
  imagenFirma           String? // ruta bajo storage root
  justificacion         String? // obligatoria para EXCEPCION_TOLERANCIA
  capturadaPorUsuarioId Int
  capturadaPor          Usuario   @relation(fields: [capturadaPorUsuarioId], references: [id])
  createdAt             DateTime  @default(now())
}

model Evidencia {
  id                 Int           @id @default(autoincrement())
  pesajeId           Int?
  pesaje             Pesaje?       @relation(fields: [pesajeId], references: [id])
  ventaId            Int?
  venta              Venta?        @relation(fields: [ventaId], references: [id])
  tipo               TipoEvidencia
  rutaArchivo        String // ruta relativa bajo storage root
  mimeType           String
  tamanoBytes        Int
  subidoPorUsuarioId Int
  subidoPor          Usuario       @relation(fields: [subidoPorUsuarioId], references: [id])
  createdAt          DateTime      @default(now())
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  entidad         String // "Lote", "Venta", ...
  entidadId       Int
  accion          String // "FOLIO_CORREGIDO", "PENALIZACION_APLICADA", "TOLERANCIA_APROBADA", "VENTA_REABIERTA"
  usuarioId       Int
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  detalleAnterior Json?
  detalleNuevo    Json?
  motivo          String?
  createdAt       DateTime @default(now())

  @@index([entidad, entidadId])
}

enum TipoNotificacion {
  PESAJE_COMPLETADO
  COMPRA_REGISTRADA
  VENTA_CERRADA
  VENTA_REQUIERE_APROBACION
}

// Un registro por evento ocurrido (no por destinatario) — el resumen se
// guarda una sola vez, sin filtrar por rol; el filtrado (ej. ocultar precio
// para OPERADOR) ocurre al leer, ver resumenParaRol() en src/lib/notificaciones.ts.
model Notificacion {
  id          Int              @id @default(autoincrement())
  tipo        TipoNotificacion
  entidad     String // "Pesaje" | "Compra" | "Venta" — mismos valores que AuditLog.entidad
  entidadId   Int
  ubicacionId Int
  ubicacion   Ubicacion        @relation(fields: [ubicacionId], references: [id])
  resumen     Json
  createdAt   DateTime         @default(now())

  destinatarios NotificacionDestinatario[]

  @@index([entidad, entidadId])
}

// Estado de entrega por destinatario — separado de Notificacion porque cada
// quien lee y recibe correo de forma independiente.
model NotificacionDestinatario {
  id              Int          @id @default(autoincrement())
  notificacionId  Int
  notificacion    Notificacion @relation(fields: [notificacionId], references: [id])
  usuarioId       Int
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])
  leidoEn         DateTime?
  requiereCorreo  Boolean // resuelto de ReglaNotificacion al crear — no se re-evalúa después
  correoEnviadoEn DateTime?
  correoIntentos  Int          @default(0)
  correoError     String?
  createdAt       DateTime     @default(now())

  @@index([usuarioId, leidoEn])
  @@index([requiereCorreo, correoEnviadoEn, correoIntentos])
}

// Configuración que arma el ADMIN: quién recibe qué. ubicacionId null =
// aplica a todas las ubicaciones. Un usuario puede tener varias reglas para
// el mismo tipo (ej. una específica de su sede y otra general) — al
// resolver destinatarios se agrupan por usuario y los canales se combinan
// con OR (ver resolverDestinatarios() en src/lib/notificaciones.ts), así
// que tener más de una regla que aplique nunca "resta" un canal.
model ReglaNotificacion {
  id          Int              @id @default(autoincrement())
  tipo        TipoNotificacion
  usuarioId   Int
  usuario     Usuario          @relation(fields: [usuarioId], references: [id])
  ubicacionId Int?
  ubicacion   Ubicacion?       @relation(fields: [ubicacionId], references: [id])
  canalInApp  Boolean          @default(true)
  canalCorreo Boolean          @default(false)
  activo      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@index([tipo, activo])
}
