{
  "name": "promerc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -r public .next/standalone/ && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/ && rm -rf deploy && mkdir -p deploy && cp -r .next/standalone/server.js .next/standalone/node_modules .next/standalone/.next .next/standalone/public deploy/ && cp package.json package-lock.json deploy/",
    "start": "next start",
    "start:standalone": "node deploy/server.js",
    "lint": "eslint",
    "test": "tsx --test src/lib/tolerancia.test.ts src/lib/netsuite.test.ts src/lib/storage.test.ts src/lib/notificaciones.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "jose": "^6.2.3",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
