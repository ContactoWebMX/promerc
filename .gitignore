# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/deploy

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
*.db
*.db-journal

# evidencia/firmas subidas por la app (disco local del servidor)
/storage/

# fotos de referencia reales compartidas para diseñar el modelo (no usadas
# por la app, no se versionan por privacidad operativa)
/fotos/
.gstack/
.impeccable/

# docs internos (incluye llaves.txt con credenciales) — no se versionan
/docs/

# paquetes armados para subir a cPanel (se regeneran con build-for-cpanel.sh)
/deploy.zip
/promerc-migrate.zip
