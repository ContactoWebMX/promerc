# Plantilla de variables de entorno para producción (cPanel → Setup Node.js
# App → Environment Variables). No es un archivo real de secretos — cópialo
# como referencia y llena los valores reales directo en la UI de cPanel,
# nunca los subas a git.

# Postgres de cPanel. cPanel suele prefijar base y usuario con el nombre de
# cuenta (ej. "usuario_promerc"). El host normalmente es localhost.
DATABASE_URL="postgresql://usuario_dbuser:CONTRASENA@localhost:5432/usuario_promerc"

# Firma de la sesión (JWT). Generar UNA VEZ por ambiente con:
#   openssl rand -base64 32
# Cambiarla invalida todas las sesiones activas. Nunca reutilizar la de dev.
SESSION_SECRET="GENERAR_CON_openssl_rand_-base64_32"

# SMTP real para el correo de recuperación de contraseña. Sin esto, el
# enlace de reset solo se imprime en el log del servidor (no llega a nadie).
SMTP_HOST="mail.tu-dominio.com"
SMTP_PORT=587
SMTP_USER="no-reply@tu-dominio.com"
SMTP_PASS="CONTRASENA_DEL_BUZON"
SMTP_FROM="PROMERC <no-reply@tu-dominio.com>"

# URL pública real de la app (se usa para armar el link del correo de reset).
APP_URL="https://promerc.tu-dominio.com"

# Ruta ABSOLUTA y persistente para evidencia/firmas, FUERA de la carpeta de
# build (esa se borra y regenera en cada despliegue). Ejemplo típico en
# cPanel: fuera de public_html, en el home del usuario.
STORAGE_ROOT="/home/usuario/promerc-storage"

# API key de Anthropic (console.anthropic.com, independiente de una
# suscripción de Claude Code) para el OCR con visión de Claude al cerrar un
# pesaje. Sin esto, la lectura automática del ticket falla silenciosamente
# y el formulario debe llenarse a mano. Tiene costo por imagen procesada.
ANTHROPIC_API_KEY="sk-ant-..."

# Puerto que cPanel/Passenger asigna a la app — normalmente lo inyecta solo,
# no hace falta fijarlo aquí a menos que el panel lo pida explícito.
# PORT=3000

NODE_ENV=production
